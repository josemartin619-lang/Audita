# --- Database (Postgres) ---
# The ledger is DB-agnostic (repository pattern). To run against Postgres,
# create the schema from src/persistence/pg/schema.sql and set:
DATABASE_URL=postgres://audita:audita@localhost:5432/audita

# --- DIAN electronic invoicing provider ---
# In production you integrate a certified Proveedor Tecnológico (PT).
# These are the credentials a real PT/adapter needs. Leave blank to use the
# built-in SandboxEInvoicingProvider (no live DIAN calls).
EINVOICE_PROVIDER=sandbox            # sandbox | <your-provider-key>
EINVOICE_API_BASE=
EINVOICE_API_TOKEN=
EINVOICE_SOFTWARE_ID=                # SoftwareID assigned by DIAN
EINVOICE_SOFTWARE_PIN=               # PIN assigned by DIAN
EINVOICE_CLAVE_TECNICA=              # ClaveTecnica per resolución de habilitación
EINVOICE_TEST_SET_ID=                # TestSetId during habilitación
DIAN_AMBIENTE=2                      # 1 = producción, 2 = pruebas/habilitación

# --- Issuer (OFE) identity ---
OFE_NIT=900123456
OFE_RAZON_SOCIAL=Comercializadora Andina S.A.S.
